# The factory itself needs no credentials. Its scripts read the filesystem and
# git, and nothing else. This file exists so that skills the factory ROUTES TO
# have one documented place to look, instead of a key ending up pasted into
# FACTORY.md, a plan, a handoff, or a commit message.
#
# Copy to .env, fill in only what you actually use, and never commit it.
# .env is already in .gitignore. Code reads process.env; artifacts reference the
# variable NAME, never its value.

# Library and API documentation lookup (github.com/upstash/context7).
# Optional — the CLI works unauthenticated at a lower rate limit.
CONTEXT7_API_KEY=

# Image, video and asset generation, if you route design-visual work to fal.ai.
FAL_KEY=

# Anything else a routed skill needs goes here with a comment saying which skill
# reads it, so a future session can tell whether it is still required.
